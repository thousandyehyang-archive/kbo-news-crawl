    <style>
      :root {
        --bg: #f7f8fa;
        --card: #ffffff;
        --border: #e9ebef;
        --ink: #1a2230;
        --muted: #5a6675;
        --faint: #9aa3b0;
        --accent: #3b5bdb;
        --track: #edeff2;
      }

      * {
        box-sizing: border-box;
      }

       
      body,
      html {
        height: 100%;
        margin: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        background: var(--bg);
        font-family:
          -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo",
          "Malgun Gothic", "맑은 고딕", dotum, 돋움, sans-serif;
        color: var(--ink);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      .img {
        margin: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .card {
        width: min(440px, calc(100vw - 32px));
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 30px 32px 30px;
        box-shadow:
          0 1px 2px rgba(16, 24, 40, 0.03),
          0 6px 20px rgba(16, 24, 40, 0.05);
        text-align: left;
      }

      .brand {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.12em;
        color: var(--faint);
        text-transform: uppercase;
        margin-bottom: 22px;
      }

      .headline {
        display: flex;
        align-items: center;
        gap: 11px;
        font-size: 17px;
        font-weight: 600;
        line-height: 1.35;
        margin: 0;
        color: var(--ink);
        letter-spacing: -0.01em;
      }

      .spinner {
        width: 17px;
        height: 17px;
        flex: 0 0 auto;
        border-radius: 50%;
        border: 2px solid var(--track);
        border-top-color: var(--accent);
        animation: spin 0.7s linear infinite;
      }

      @keyframes spin {
        from {
          transform: rotate(0deg);
        }
        to {
          transform: rotate(360deg);
        }
      }

      .sub {
        margin: 13px 0 0;
        font-size: 14px;
        line-height: 1.65;
        color: var(--muted);
      }

       
      .centered-div {
        text-align: left;
        max-width: none;
      }

       
      #image {
        display: none !important;
      }

       
      #progress {
        width: 100% !important;
        height: 5px !important;
        margin: 22px 0 6px !important;
        border-radius: 999px !important;
        background: var(--track);
        outline: none !important;
        outline-offset: 0 !important;
      }

      .bar-inner {
        background: var(--accent) !important;
        border-radius: 999px;
      }

       
      #status {
        font-size: 12.5px;
        color: var(--faint);
        margin: 14px 0 0;
      }

       
      details.why {
        margin-top: 20px;
        border-top: 1px solid var(--border);
        padding-top: 16px;
      }

      details.why > summary {
        cursor: pointer;
        list-style: none;
        font-size: 13.5px;
        font-weight: 600;
        color: var(--muted);
        display: flex;
        align-items: center;
        gap: 6px;
      }

      details.why > summary::-webkit-details-marker {
        display: none;
      }

      details.why > summary::after {
        content: "⌄";
        margin-left: auto;
        transition: transform 0.2s ease;
        color: var(--faint);
      }

      details.why[open] > summary::after {
        transform: rotate(180deg);
      }

      details.why p {
        margin: 12px 0 0;
        font-size: 13px;
        line-height: 1.7;
        color: var(--muted);
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0e1117;
          --card: #161b27;
          --border: #252d3d;
          --ink: #e4e8f0;
          --muted: #8892a4;
          --faint: #4e5769;
          --accent: #5c7cfa;
          --track: #252d3d;
        }

        .card {
          box-shadow:
            0 1px 2px rgba(0, 0, 0, 0.3),
            0 6px 24px rgba(0, 0, 0, 0.35);
        }
      }
    </style>
